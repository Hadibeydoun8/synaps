FROM debian:12-slim AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    wget \
    file \
    git \
    pkg-config \
    unzip \
    xz-utils \
    jq \
    libwebkit2gtk-4.1-dev \
    libxdo-dev \
    libssl-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libfuse2 \
    patchelf \
    rpm \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd \
    --create-home \
    --uid 1000 \
    --shell /bin/bash \
    jenkins

ENV HOME=/home/jenkins
ENV RUSTUP_HOME=/home/jenkins/.rustup
ENV CARGO_HOME=/home/jenkins/.cargo
ENV BUN_INSTALL=/home/jenkins/.bun

# Important: stable target directory outside Jenkins workspace
ENV CARGO_TARGET_DIR=/home/jenkins/.cargo-target

ENV PATH="/home/jenkins/.cargo/bin:/home/jenkins/.bun/bin:${PATH}"

RUN mkdir -p /home/jenkins/.cargo-target && \
    chown -R jenkins:jenkins /home/jenkins

USER jenkins

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable

RUN rustup component add rustfmt clippy

RUN cargo install cargo-chef --locked

RUN curl -fsSL https://bun.sh/install | bash


# --------------------------------------------------
# Generate dependency recipe
# --------------------------------------------------

FROM base AS planner

WORKDIR /build

COPY --chown=jenkins:jenkins . .

WORKDIR /build/src-tauri

RUN cargo chef prepare --recipe-path recipe.json


# --------------------------------------------------
# CI image
# --------------------------------------------------

FROM base AS ci

WORKDIR /build/src-tauri

COPY --from=planner /build/src-tauri/recipe.json recipe.json

# Debug dependencies: clippy/tests
RUN cargo chef cook \
    --all-features \
    --recipe-path recipe.json

# Release dependencies: Tauri release build
RUN cargo chef cook \
    --release \
    --all-features \
    --recipe-path recipe.json

WORKDIR /workspace

RUN rustc --version \
    && cargo --version \
    && cargo chef --version \
    && bun --version
